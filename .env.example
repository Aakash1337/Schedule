NODE_ENV=development
LOG_LEVEL=info
API_HOST=127.0.0.1
API_PORT=4000
# Comma-delimited exact provider proxy IPs/CIDRs (IPv4 /8+, IPv6 /32+). Split broader ranges.
# Leave empty unless requests arrive through proxies whose published ranges you have verified.
API_TRUSTED_PROXIES=
PRODUCT_API_MODE=local_unauthenticated
# Hosted browser routes have no enabling mode yet. The optional non-secret registration values below
# must be staged together; secrets and unknown HOSTED_* companions remain rejected.
HOSTED_API_MODE=disabled
# HOSTED_PUBLIC_ORIGIN=https://schedule.example.com
# HOSTED_OIDC_ISSUER=https://login.example.com
# HOSTED_OIDC_CLIENT_ID=schedule-browser
# Per-source loopback product request limit. Keep the default unless a controlled local workload needs more.
PRODUCT_RATE_LIMIT_PER_MINUTE=240
# Opt in only to a local Ollama server. The strict 127.0.0.1 origin keeps schedule context local.
LOCAL_MODEL_ADVISOR_MODE=disabled
# Proposal generation is separate from read-only advice and remains disabled unless explicitly enabled.
LOCAL_MODEL_PROPOSAL_MODE=disabled
# Required when proposal mode is ollama; use a stable random secret of at least 32 bytes.
# LOCAL_MODEL_PROPOSAL_HMAC_KEY=replace-with-a-cryptographically-random-secret
LOCAL_MODEL_PROPOSAL_TTL_SECONDS=600
LOCAL_MODEL_ADVISOR_URL=http://127.0.0.1:11434
LOCAL_MODEL_ADVISOR_MODEL=gemma4:e4b
LOCAL_MODEL_ADVISOR_CONNECT_TIMEOUT_MS=2000
LOCAL_MODEL_ADVISOR_REQUEST_TIMEOUT_MS=60000
LOCAL_MODEL_ADVISOR_MAX_RESPONSE_BYTES=32768
LOCAL_MODEL_ADVISOR_MAX_CONCURRENT=1
INTEGRATION_API_MODE=disabled
# Required when INTEGRATION_API_MODE=enabled. Generate a random value with at least 32 characters.
# INTEGRATION_API_PEPPER=replace-with-a-cryptographically-random-secret
INTEGRATION_CONFIRMATION_TTL_SECONDS=600
INTEGRATION_RATE_LIMIT_PER_MINUTE=120
DATABASE_URL=postgres://schedule:schedule@127.0.0.1:5432/schedule
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=25
OUTBOX_MAX_ATTEMPTS=8
# Disabled by default. When enabled, binds health and metrics only to 127.0.0.1.
WORKER_OBSERVABILITY_MODE=disabled
WORKER_OBSERVABILITY_PORT=9464
# Disabled by default. This creates local notification intents only; it never sends them.
NOTIFICATION_MATERIALIZATION_MODE=disabled
NOTIFICATION_MATERIALIZATION_INTERVAL_MS=60000
NOTIFICATION_MATERIALIZATION_LOOKAHEAD_MS=300000
# Disabled by default. Enable only after a secure production HTTPS receiver and keyring are ready.
WEBHOOK_DELIVERY_MODE=disabled
# Comma-delimited lowercase key-id:canonical-unpadded-base64url-32-byte-key entries (maximum 8).
# Generate a key with: pnpm webhooks -- generate-master-key --id primary
# WEBHOOK_MASTER_KEYS=primary:replace-with-a-43-character-base64url-key
# WEBHOOK_ACTIVE_MASTER_KEY_ID=primary
WEBHOOK_CONNECT_TIMEOUT_MS=5000
WEBHOOK_REQUEST_TIMEOUT_MS=15000
WEBHOOK_MAX_RESPONSE_BYTES=65536
WEBHOOK_MAX_RETRY_AFTER_MS=300000
# Drop queued webhook deliveries older than seven days rather than attempting stale notifications.
WEBHOOK_MAX_DELIVERY_AGE_MS=604800000
