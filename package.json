{
  "name": "schedule",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm run build:packages && pnpm --parallel --filter @schedule/api --filter @schedule/worker --filter @schedule/web run dev",
    "clean": "node scripts/clean.mjs",
    "build:packages": "pnpm clean && pnpm -r --filter \"./packages/**\" run build",
    "build": "pnpm clean && pnpm -r run build",
    "typecheck": "pnpm typecheck:scripts && pnpm -r run typecheck",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "test": "pnpm test:scripts && pnpm -r run test",
    "test:scripts": "vitest run --dir scripts",
    "test:coverage": "vitest run --config vitest.coverage.config.ts --coverage",
    "eval:features": "tsx scripts/evaluate-features.ts",
    "eval:planner": "pnpm --filter @schedule/domain exec vitest run src/planner-evaluation.test.ts",
    "eval:unit": "pnpm test:coverage",
    "eval:integration": "pnpm build:packages && pnpm db:migrate && pnpm verify:database && pnpm verify:backup-restore && pnpm verify:recovery-state-machine",
    "eval": "pnpm eval:features && pnpm eval:unit",
    "eval:full": "pnpm eval && pnpm eval:integration && pnpm verify:web-e2e",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @schedule/database run db:generate",
    "db:migrate": "pnpm --filter @schedule/database run db:migrate",
    "db:studio": "pnpm --filter @schedule/database run db:studio",
    "integration:credentials": "tsx scripts/integration-credentials.ts",
    "integration:cleanup": "tsx scripts/cleanup-integration-history.ts",
    "webhooks": "tsx scripts/webhook-endpoints.ts",
    "db:backup": "tsx scripts/backup-database.ts",
    "db:restore": "tsx scripts/restore-database.ts",
    "db:restore:rollback": "tsx scripts/restore-database.ts --rollback",
    "db:restore:cleanup": "tsx scripts/cleanup-restored-database.ts",
    "verify:planner-db": "tsx scripts/verify-planner-db.ts",
    "verify:product-api": "tsx scripts/verify-product-api.ts",
    "verify:integration-gateway": "tsx scripts/verify-integration-gateway.ts",
    "verify:local-model-advisor": "tsx scripts/verify-local-model-advisor.ts",
    "verify:natural-language-proposals": "tsx scripts/verify-natural-language-proposals.ts",
    "verify:notification-core": "tsx scripts/verify-notification-core.ts",
    "verify:notification-delivery": "tsx scripts/verify-notification-delivery.ts",
    "verify:notification-migrations": "tsx scripts/verify-notification-migrations.ts",
    "verify:webhook-delivery": "tsx scripts/verify-webhook-delivery.ts",
    "verify:database": "pnpm verify:planner-db && pnpm verify:product-api && pnpm verify:natural-language-proposals && pnpm verify:integration-gateway && pnpm verify:notification-core && pnpm verify:notification-delivery && pnpm verify:outbox-db && pnpm verify:webhook-delivery && pnpm verify:plan-state-migrations && pnpm verify:weekday-migrations && pnpm verify:notification-migrations",
    "verify:outbox-db": "tsx scripts/verify-outbox-db.ts",
    "verify:plan-state-migrations": "tsx scripts/verify-plan-state-migrations.ts",
    "verify:weekday-migrations": "tsx scripts/verify-weekday-migrations.ts",
    "verify:backup-restore": "tsx scripts/verify-backup-restore.ts",
    "verify:recovery-state-machine": "tsx scripts/run-recovery-state-machine-verification.ts",
    "build:web-e2e": "pnpm build:packages && pnpm --filter @schedule/api build && pnpm --filter @schedule/web build",
    "verify:web-e2e": "pnpm build:web-e2e && tsx scripts/run-web-e2e.ts",
    "infra:up": "docker compose up -d postgres",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f postgres",
    "check": "pnpm build:packages && pnpm format:check && pnpm lint && pnpm typecheck && pnpm eval:features && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@types/node": "^24.10.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.7.0",
    "prettier": "3.9.5",
    "tsx": "4.23.0",
    "typescript": "6.0.2",
    "typescript-eslint": "8.63.0",
    "vitest": "4.1.10"
  }
}
